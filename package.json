{
  "name": "hackwarts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,vite -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-preserve-output --watch-path=server/index.js --watch-path=server/app.js --watch-path=server/paymentRoutes.js --watch-path=server/paymentMailer.js --watch-path=server/shortlistedTeamsStore.js --watch-path=.env server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "test": "node --test server/*.test.js",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test:server": "node --test server/*.test.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@types/three": "^0.187.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.68.0",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
