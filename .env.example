# Payment gateway selection: instamojo or razorpay.
# When unset, Instamojo is selected if its API key and auth token are configured.
PAYMENT_GATEWAY=

# Instamojo Payment Request API v1.1
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
INSTAMOJO_SALT=
INSTAMOJO_BASE_URL=https://www.instamojo.com/api/1.1

# Razorpay remains available when PAYMENT_GATEWAY=razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PAYMENT_LINK=https://razorpay.me/@sathwikshettyneralakatte

# Public origin used for payment redirects and webhooks.
PUBLIC_SITE_URL=https://hackwarts-2026.vercel.app

# Secret shared with Apps Script for protected shortlist and registration reads.
APPS_SCRIPT_STORAGE_SECRET=
